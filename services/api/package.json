{
  "name": "@boardops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit --pretty false",
    "db:migrate:local": "wrangler d1 migrations apply boardops-local --local",
    "db:seed:local": "wrangler d1 execute boardops-local --local --file=../../scripts/seed-local.sql"
  },
  "dependencies": {
    "hono": "4.13.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260827.1",
    "typescript": "7.0.2",
    "wrangler": "4.126.0"
  }
}
