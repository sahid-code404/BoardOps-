{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boardops-api",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-29",
  "vars": {
    "APP_ENV": "local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boardops-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "boardops-local-files"
    }
  ]
}
